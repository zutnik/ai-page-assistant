{
  "name": "zutnik/ai-page-assistant",
  "description": "Provider-agnostic OpenRouter AI chat assistant for WordPress pages.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "keywords": [
    "wordpress",
    "plugin",
    "openrouter",
    "ai",
    "chatbot",
    "sse",
    "gdpr"
  ],
  "authors": [
    {
      "name": "zutnik",
      "homepage": "https://github.com/zutnik"
    }
  ],
  "support": {
    "issues": "https://github.com/zutnik/ai-page-assistant/issues",
    "source": "https://github.com/zutnik/ai-page-assistant"
  },
  "autoload": {
    "psr-4": {
      "AiPageAssistant\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AiPageAssistant\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "phpunit",
    "dump": "composer dump-autoload"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
